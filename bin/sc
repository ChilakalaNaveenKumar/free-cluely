#!/bin/bash
# Screen Copilot as a background service (launchd), independent of any terminal.
#   sc start | stop | restart | status | logs | build | login on|off
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
LABEL="com.screencopilot.app"
HOME_DIR="$HOME/.screen-copilot"
PLIST="$HOME_DIR/$LABEL.plist"
LOGIN_PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME_DIR/app.log"
# "Screen Copilot.app" is signed once and never rebuilt: inside it a fixed starter loads this
# repo's code, so code updates don't change its signature and the Screen Recording grant lasts.
BUNDLE="/Applications/Screen Copilot.app"
BIN="$BUNDLE/Contents/MacOS/Screen Copilot"
DOMAIN="gui/$(id -u)"

write_plist() {
  mkdir -p "$HOME_DIR"
  # Vertex login: the service account your shell uses (no re-auth expiry); without it the app
  # falls back to the gcloud user login, which Workspace makes you renew.
  CREDS_ENTRY=""
  # SC_DEBUG_PORT (local devtools port) only when set for a test run
  [ -n "${SC_DEBUG_PORT:-}" ] && CREDS_ENTRY_DBG="
    <key>SC_DEBUG_PORT</key><string>$SC_DEBUG_PORT</string>" || CREDS_ENTRY_DBG=""
  if [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]; then
    CREDS_ENTRY="
    <key>GOOGLE_APPLICATION_CREDENTIALS</key><string>$GOOGLE_APPLICATION_CREDENTIALS</string>"
  fi
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$BIN</string></array>
  <key>WorkingDirectory</key><string>$APP_DIR</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key><string>production</string>
    <key>SC_SERVICE</key><string>1</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>$CREDS_ENTRY$CREDS_ENTRY_DBG
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- restart after a crash, but not after Quit from the menu bar -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
}

running() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }

build() {
  cd "$APP_DIR"
  [ -x native/bin/ocr ] || npm run -s build:ocr
  npx vite build >/dev/null
  npx tsc -p electron/tsconfig.json
}

make_bundle() {
  local src="$APP_DIR/release/mac-arm64/Screen Copilot.app"
  # electron-builder gives the app and its helpers the right names ("Screen Copilot Helper", …)
  [ -d "$src" ] || (cd "$APP_DIR" && CSC_IDENTITY_AUTO_DISCOVERY=false npx electron-builder --mac dir >/dev/null)
  mkdir -p "$HOME_DIR"
  rm -rf "$BUNDLE"
  cp -R "$src" "$BUNDLE"
  local res="$BUNDLE/Contents/Resources"
  rm -rf "$res/app.asar" "$res/app.asar.unpacked" "$res/native"
  mkdir -p "$res/app"
  printf '{ "name": "screen-copilot", "productName": "Screen Copilot", "main": "main.js" }\n' >"$res/app/package.json"
  cat >"$res/app/main.js" <<JS
// Fixed starter: runs the code in the repo, so this signed app never has to change.
require("$APP_DIR/dist-electron/main.js")
JS
  codesign --force --deep -s - "$BUNDLE" >/dev/null 2>&1
}

case "${1:-status}" in
  build) build && echo "built" ;;
  start)
    running && { echo "already running"; exit 0; }
    [ -x "$BIN" ] || make_bundle
    [ -f "$APP_DIR/dist/index.html" ] || build
    write_plist
    launchctl bootstrap "$DOMAIN" "$PLIST"
    echo "started (logs: $LOG)"
    ;;
  stop)
    if running; then
      launchctl bootout "$DOMAIN/$LABEL"
      for _ in $(seq 1 50); do running || break; sleep 0.2; done # bootout returns before launchd is done
      echo "stopped"
    else echo "not running"; fi
    ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
  status)
    if running; then
      pid=$(launchctl print "$DOMAIN/$LABEL" | awk '/pid =/ {print $3; exit}')
      echo "running (pid ${pid:-?})"
    else echo "not running"; fi
    [ -f "$LOGIN_PLIST" ] && echo "starts at login: on" || echo "starts at login: off"
    ;;
  logs) tail -n "${2:-50}" -f "$LOG" ;;
  login)
    case "${2:-}" in
      on) write_plist && cp "$PLIST" "$LOGIN_PLIST" && echo "will start at login" ;;
      off) rm -f "$LOGIN_PLIST" && echo "will not start at login" ;;
      *) echo "usage: sc login on|off"; exit 1 ;;
    esac
    ;;
  *) echo "usage: sc start|stop|restart|status|logs|build|login on|off"; exit 1 ;;
esac
