#!/bin/bash
# Screen Copilot as a background service (launchd), independent of any terminal.
#   sc start | stop | restart | status | logs | build | login on|off
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
LABEL="com.screencopilot.app"
HOME_DIR="$HOME/.screen-copilot"
PLIST="$HOME_DIR/$LABEL.plist"
LOGIN_PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME_DIR/app.log"
ELECTRON="$APP_DIR/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
DOMAIN="gui/$(id -u)"

write_plist() {
  mkdir -p "$HOME_DIR"
  # Vertex login: the service account your shell uses (no re-auth expiry); without it the app
  # falls back to the gcloud user login, which Workspace makes you renew.
  CREDS_ENTRY=""
  if [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]; then
    CREDS_ENTRY="
    <key>GOOGLE_APPLICATION_CREDENTIALS</key><string>$GOOGLE_APPLICATION_CREDENTIALS</string>"
  fi
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$ELECTRON</string><string>$APP_DIR</string></array>
  <key>WorkingDirectory</key><string>$APP_DIR</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key><string>production</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>$CREDS_ENTRY
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- restart after a crash, but not after Quit from the menu bar -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
}

running() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }

build() {
  cd "$APP_DIR"
  npx vite build >/dev/null
  npx tsc -p electron/tsconfig.json
  [ -x native/bin/ocr ] || npm run -s build:ocr
}

case "${1:-status}" in
  build) build && echo "built" ;;
  start)
    running && { echo "already running"; exit 0; }
    [ -f "$APP_DIR/dist/index.html" ] || build
    write_plist
    launchctl bootstrap "$DOMAIN" "$PLIST"
    echo "started (logs: $LOG)"
    ;;
  stop)
    if running; then
      launchctl bootout "$DOMAIN/$LABEL"
      for _ in $(seq 1 50); do running || break; sleep 0.2; done # bootout returns before launchd is done
      echo "stopped"
    else echo "not running"; fi
    ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
  status)
    if running; then
      pid=$(launchctl print "$DOMAIN/$LABEL" | awk '/pid =/ {print $3; exit}')
      echo "running (pid ${pid:-?})"
    else echo "not running"; fi
    [ -f "$LOGIN_PLIST" ] && echo "starts at login: on" || echo "starts at login: off"
    ;;
  logs) tail -n "${2:-50}" -f "$LOG" ;;
  login)
    case "${2:-}" in
      on) write_plist && cp "$PLIST" "$LOGIN_PLIST" && echo "will start at login" ;;
      off) rm -f "$LOGIN_PLIST" && echo "will not start at login" ;;
      *) echo "usage: sc login on|off"; exit 1 ;;
    esac
    ;;
  *) echo "usage: sc start|stop|restart|status|logs|build|login on|off"; exit 1 ;;
esac
